# macOS
.DS_Store

# Xcode user/local state
xcuserdata/
*.xcuserdata/
*.xcuserstate
*.moved-aside
AwemeBillingApp/*.xcodeproj/project.xcworkspace/
AwemeBillingApp/*.xcodeproj/xcuserdata/

# Xcode build products and archives
DerivedData*/
Build*/
*.app
*.appex
*.ipa
*.xcarchive
*.dSYM
*.dSYM.zip
*.xcresult
*.xccovarchive
*.xccovreport

# Swift Package Manager and compiler caches
.build/
.swiftpm/
.module-cache/
ModuleCache.noindex/

# Local secrets
LocalSecrets.xcconfig
*.secret.xcconfig

# Python/tool caches
__pycache__/
*.py[cod]

# Local Codex/tooling state
.codex/

# Local vendor SDK downloads/reference packages.
# If a vendor SDK becomes a real build dependency, vendor only the exact
# framework/resource bundle used by the Xcode project instead of the full demo/doc package.
OCR_iOS_SDK_v*/

# Local simulator/debug screenshots
/*.png
/*.PNG
AwemeBillingApp/*.png
AwemeBillingApp/*.PNG
simulator-*.png
*-launch.png
ui-redesign-*.png
awemebilling-openai-launch.png
simulator-ocrspace-home.png

# fastlane generated output
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
